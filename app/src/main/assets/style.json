{
  "version": 8,
  "name": "OffNav Basic",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sprite": "asset://sprites/sprite",
  "sources": {
    "offline": {
      "type": "vector",
      "url": "{MBTILES_PATH}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ea"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "offline",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0c8f0"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "offline",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e6e4da"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "offline",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "offline",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#c9c4bb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 18, 14]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "offline",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 10]
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "offline",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["==", ["geometry-type"], "LineString"],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 18, 14],
        "text-max-angle": 30,
        "text-padding": 2,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#2b2b2b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road-shield",
      "type": "symbol",
      "source": "offline",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "filter": ["has", "ref"],
      "layout": {
        "symbol-placement": "line",
        "icon-image": [
          "match",
          ["get", "ref_length"],
          1, "road_1",
          2, "road_2",
          3, "road_3",
          4, "road_4",
          5, "road_5",
          "road_6"
        ],
        "text-field": ["get", "ref"],
        "text-font": ["Noto Sans Medium"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#2b2b2b"
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "offline",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village", "suburb"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 14, 18],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#1a1a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "offline",
      "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "icon-image": [
          "coalesce",
          ["image", ["concat", ["get", "class"], "_11"]],
          ["image", "marker_11"]
        ],
        "icon-size": 0.9,
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [0, 0.8],
        "text-optional": true
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "housenumber",
      "type": "symbol",
      "source": "offline",
      "source-layer": "housenumber",
      "minzoom": 17,
      "layout": {
        "text-field": ["get", "housenumber"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 9
      },
      "paint": {
        "text-color": "#888888"
      }
    }
  ]
}
