{
  "version": 8,
  "name": "OffNav Basic",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "offline": {
      "type": "vector",
      "url": "{MBTILES_PATH}"
    }
  },
  "layers": [
    { "id": "background", "type": "background",
      "paint": { "background-color": "#f4f1ea" } },
    { "id": "water", "type": "fill", "source": "offline", "source-layer": "water",
      "paint": { "fill-color": "#a0c8f0" } },
    { "id": "landuse", "type": "fill", "source": "offline", "source-layer": "landuse",
      "paint": { "fill-color": "#e6e4da" } },
    { "id": "buildings", "type": "fill", "source": "offline", "source-layer": "building",
      "paint": { "fill-color": "#d9d0c9", "fill-opacity": 0.7 } },
    { "id": "roads-casing", "type": "line", "source": "offline", "source-layer": "transportation",
      "paint": { "line-color": "#c9c4bb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 18, 14] } },
    { "id": "roads", "type": "line", "source": "offline", "source-layer": "transportation",
      "paint": { "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 10] } },
    { "id": "road-label", "type": "symbol", "source": "offline",
      "source-layer": "transportation_name", "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["has", "name:latin"]],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-field": ["get", "name:latin"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 14, 12, 18, 15],
        "text-max-angle": 30,
        "text-padding": 2,
        "text-keep-upright": true,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#2b2b2b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      } }
  ]
}
